---
import Default from '@astrojs/starlight/components/Footer.astro';
import type { Props } from '@astrojs/starlight/props';
import KeyboardShortcuts from '../KeyboardShortcuts.tsx';
import Comments from '../Comments.tsx';
import { withBase } from '../../lib/url';
const props = Astro.props as Props;

// Show comments on lessons only — anything under paths/<slug>/<module>/...
const id = props.entry?.id ?? '';
const isLesson = id.startsWith('paths/') && id.split('/').length >= 4;

const year = new Date().getFullYear();
---

<Default {...props}><slot /></Default>

{isLesson && <Comments client:visible />}

<KeyboardShortcuts client:idle />

<footer class="atlas-foot" role="contentinfo">
  <div class="atlas-foot__top" aria-hidden="true"></div>

  <div class="atlas-foot__inner">
    <!-- Brand block -->
    <section class="atlas-foot__brand">
      <a class="atlas-foot__mark" href={withBase('/')} aria-label="Atlas — home">
        <svg viewBox="0 0 64 64" width="40" height="40" aria-hidden="true">
          <defs>
            <linearGradient id="atlas-foot-mark" x1="0" y1="0" x2="64" y2="64">
              <stop offset="0%" stop-color="#F5B14A" />
              <stop offset="100%" stop-color="#d8902b" />
            </linearGradient>
          </defs>
          <circle cx="32" cy="32" r="29" fill="none" stroke="url(#atlas-foot-mark)" stroke-width="2.5" />
          <circle cx="32" cy="32" r="3.4" fill="url(#atlas-foot-mark)" />
          <path d="M32 6 L37 30 L32 32 L27 30 Z" fill="url(#atlas-foot-mark)" />
          <path d="M32 58 L37 34 L32 32 L27 34 Z" fill="url(#atlas-foot-mark)" opacity="0.45" />
          <path d="M6 32 L30 27 L32 32 L30 37 Z" fill="url(#atlas-foot-mark)" opacity="0.6" />
          <path d="M58 32 L34 27 L32 32 L34 37 Z" fill="url(#atlas-foot-mark)" opacity="0.6" />
        </svg>
        <span class="atlas-foot__wordmark">Atlas</span>
      </a>
      <p class="atlas-foot__tagline">Your map to modern web development.</p>
      <p class="atlas-foot__pitch">
        Free, open-source, beautifully designed — built by working developers, in public.
        From <em>"what is HTTP?"</em> to shipping a production full-stack app.
      </p>
      <div class="atlas-foot__chips">
        <span class="atlas-foot__chip">9 paths</span>
        <span class="atlas-foot__chip">245+ lessons</span>
        <span class="atlas-foot__chip">free forever</span>
      </div>
    </section>

    <!-- Explore Atlas -->
    <nav class="atlas-foot__col" aria-labelledby="atlas-foot-explore">
      <h3 id="atlas-foot-explore">Explore</h3>
      <ul>
        <li><a href={withBase('/start/')}>Pick a starting point</a></li>
        <li><a href={withBase('/paths/')}>Learning paths</a></li>
        <li><a href={withBase('/reference/')}>Reference</a></li>
        <li><a href={withBase('/roadmaps/')}>Roadmaps</a></li>
        <li><a href={withBase('/cheatsheets/')}>Cheatsheets</a></li>
        <li><a href={withBase('/projects/')}>Projects</a></li>
        <li><a href={withBase('/glossary/')}>Glossary</a></li>
      </ul>
    </nav>

    <!-- Project / contribute -->
    <nav class="atlas-foot__col" aria-labelledby="atlas-foot-project">
      <h3 id="atlas-foot-project">Project</h3>
      <ul>
        <li><a href={withBase('/about/')}>About Atlas</a></li>
        <li><a href={withBase('/contribute/')}>How to contribute</a></li>
        <li><a href="https://github.com/sitharaj88/atlas" rel="noopener">Source on GitHub</a></li>
        <li><a href="https://github.com/sitharaj88/atlas/issues" rel="noopener">Report an issue</a></li>
        <li><a href="https://github.com/sitharaj88/atlas/discussions" rel="noopener">Discussions</a></li>
        <li><a href={withBase('/rss.xml')}>RSS feed</a></li>
      </ul>
    </nav>

    <!-- Author card -->
    <section class="atlas-foot__author" aria-labelledby="atlas-foot-author">
      <h3 id="atlas-foot-author">Author</h3>
      <a class="atlas-foot__author-name" href="https://sitharaj.in" rel="author noopener">
        Sitharaj Seenivasan
      </a>
      <p class="atlas-foot__author-role">Working developer · making the map I wish I had.</p>
      <ul class="atlas-foot__socials" aria-label="Author links">
        <li>
          <a href="https://sitharaj.in" aria-label="Personal website — sitharaj.in" rel="noopener">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="9" />
              <path d="M3 12h18" />
              <path d="M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" />
            </svg>
            <span>sitharaj.in</span>
          </a>
        </li>
        <li>
          <a href="https://github.com/sitharaj88" aria-label="GitHub — sitharaj88" rel="noopener">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="currentColor">
              <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2c-3.2.7-3.88-1.36-3.88-1.36-.52-1.31-1.27-1.66-1.27-1.66-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.24 3.34.95.1-.74.4-1.24.73-1.53-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.96 10.96 0 0 1 5.74 0c2.18-1.49 3.14-1.18 3.14-1.18.62 1.59.23 2.76.11 3.05.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.41-5.26 5.69.41.36.78 1.06.78 2.14v3.18c0 .31.21.68.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5Z" />
            </svg>
            <span>@sitharaj88</span>
          </a>
        </li>
        <li>
          <a href="https://www.linkedin.com/in/sitharaj08" aria-label="LinkedIn — sitharaj08" rel="noopener">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="currentColor">
              <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.61 0 4.28 2.38 4.28 5.47v6.27ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.55V9h3.57v11.45ZM22.23 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.72V1.72C24 .77 23.21 0 22.23 0Z" />
            </svg>
            <span>in/sitharaj08</span>
          </a>
        </li>
        <li>
          <a href="mailto:sitharaj.info@gmail.com" aria-label="Email — sitharaj.info@gmail.com">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m3 7 9 6 9-6" />
            </svg>
            <span>Email</span>
          </a>
        </li>
      </ul>
      <a class="atlas-foot__bmc" href="https://www.buymeacoffee.com/sitharaj88" rel="noopener" aria-label="Buy me a coffee — sitharaj88">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="currentColor">
          <path d="M3.5 9h13.66v1.07c0 4.7-3.06 8.5-6.83 8.5S3.5 14.77 3.5 10.07V9Zm15.16-1.4h-1.5v-.43A1.17 1.17 0 0 0 16 6H4.16A1.17 1.17 0 0 0 3 7.17v3.42c0 5.36 3.7 9.91 8.33 9.91 4 0 7.34-3.4 8.16-7.92h.18a3 3 0 0 0 0-6Zm0 4.6h-.04c.04-.42.04-.83.04-1.25v-1.95a1.6 1.6 0 0 1 0 3.2ZM6.7 4.95c.47-.47.47-1.23 0-1.7-.34-.34-.34-.85 0-1.18a.6.6 0 1 0-.85-.85c-.81.81-.81 2.07 0 2.88.13.13.13.34 0 .47a.6.6 0 1 0 .85.38Zm3 0c.47-.47.47-1.23 0-1.7-.34-.34-.34-.85 0-1.18a.6.6 0 1 0-.85-.85c-.81.81-.81 2.07 0 2.88.13.13.13.34 0 .47a.6.6 0 1 0 .85.38Zm3 0c.47-.47.47-1.23 0-1.7-.34-.34-.34-.85 0-1.18a.6.6 0 1 0-.85-.85c-.81.81-.81 2.07 0 2.88.13.13.13.34 0 .47a.6.6 0 1 0 .85.38Z" />
        </svg>
        <span>Buy me a coffee</span>
      </a>
    </section>
  </div>

  <!-- Bottom bar -->
  <div class="atlas-foot__bar">
    <p class="atlas-foot__copy">
      © {year} <a href="https://sitharaj.in" rel="author noopener">Sitharaj Seenivasan</a>
      · Code <a href="https://github.com/sitharaj88/atlas/blob/main/LICENSE" rel="noopener">MIT</a>
      · Content <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="noopener">CC BY-SA 4.0</a>
    </p>
    <p class="atlas-foot__credit">
      Built with <a href="https://astro.build" rel="noopener">Astro</a>,
      <a href="https://starlight.astro.build" rel="noopener">Starlight</a>,
      and a lot of late nights
      · Press <kbd>?</kbd> for shortcuts
    </p>
  </div>
</footer>

<style>
  .atlas-foot {
    --foot-text: var(--sl-color-gray-3);
    --foot-strong: var(--sl-color-text);
    --foot-bg: color-mix(in oklch, var(--sl-color-bg-sidebar) 60%, var(--sl-color-bg));
    --foot-line: var(--sl-color-hairline);
    --foot-shade: var(--sl-color-hairline-light);
    --foot-accent: var(--atlas-amber-400, #F5B14A);

    position: relative;
    margin-top: var(--atlas-sp-16);
    padding: 3rem clamp(1.25rem, 4vw, 4rem) 1.5rem;
    background:
      radial-gradient(ellipse 50% 80% at 50% 0%,
        color-mix(in oklch, var(--foot-accent) 7%, transparent) 0%,
        transparent 70%),
      var(--foot-bg);
    color: var(--foot-text);
    font-size: var(--atlas-fs-sm);
    line-height: 1.55;
  }

  /* Top hairline + amber gradient sliver */
  .atlas-foot__top {
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 1px;
    background: linear-gradient(90deg,
      transparent 0%,
      color-mix(in oklch, var(--foot-accent) 50%, transparent) 50%,
      transparent 100%);
  }

  .atlas-foot__inner {
    max-width: 80rem;
    margin: 0 auto;
    display: grid;
    gap: 2.25rem 2rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 48rem) {
    .atlas-foot__inner {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 64rem) {
    .atlas-foot__inner {
      grid-template-columns: 2fr 1fr 1fr 1.4fr;
    }
  }

  /* Brand block */
  .atlas-foot__brand { max-width: 28rem; }
  .atlas-foot__mark {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--foot-strong);
  }
  .atlas-foot__mark:hover .atlas-foot__wordmark {
    color: var(--foot-accent);
  }
  .atlas-foot__wordmark {
    font-family: var(--atlas-font-display, inherit);
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    transition: color var(--atlas-dur-fast, 180ms) ease;
  }
  .atlas-foot__tagline {
    margin: 0.5rem 0 0;
    color: var(--foot-strong);
    font-size: 0.95rem;
    font-weight: 500;
  }
  .atlas-foot__pitch {
    margin: 0.5rem 0 0;
    max-width: 26rem;
  }
  .atlas-foot__pitch em {
    color: var(--foot-strong);
    font-style: italic;
  }
  .atlas-foot__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.9rem;
  }
  .atlas-foot__chip {
    display: inline-flex;
    align-items: center;
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: color-mix(in oklch, var(--foot-accent) 12%, transparent);
    color: color-mix(in oklch, var(--foot-accent) 80%, var(--foot-strong));
    border: 1px solid color-mix(in oklch, var(--foot-accent) 30%, transparent);
  }

  /* Link columns */
  .atlas-foot__col h3,
  .atlas-foot__author h3 {
    margin: 0 0 0.85rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--foot-strong);
  }
  .atlas-foot__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }
  .atlas-foot__col a {
    color: var(--foot-text);
    text-decoration: none;
    transition: color var(--atlas-dur-fast, 180ms) ease;
  }
  .atlas-foot__col a:hover {
    color: var(--sl-color-text-accent);
  }

  /* Author card */
  .atlas-foot__author { display: flex; flex-direction: column; }
  .atlas-foot__author-name {
    color: var(--foot-strong);
    font-weight: 600;
    text-decoration: none;
    font-size: 1rem;
    border-bottom: 1px dotted transparent;
    align-self: start;
  }
  .atlas-foot__author-name:hover {
    color: var(--sl-color-text-accent);
    border-bottom-color: currentColor;
  }
  .atlas-foot__author-role {
    margin: 0.25rem 0 0.85rem;
    font-size: 0.82rem;
  }
  .atlas-foot__socials {
    list-style: none;
    margin: 0 0 0.7rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .atlas-foot__socials a,
  .atlas-foot__bmc {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--foot-line);
    border-radius: 999px;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    font-size: 0.78rem;
    background: var(--sl-color-bg);
    transition:
      border-color var(--atlas-dur-fast, 180ms) ease,
      color var(--atlas-dur-fast, 180ms) ease,
      transform var(--atlas-dur-fast, 180ms) ease;
  }
  .atlas-foot__socials a:hover,
  .atlas-foot__bmc:hover {
    border-color: var(--foot-accent);
    color: var(--sl-color-text-accent);
    transform: translateY(-1px);
  }
  .atlas-foot__bmc {
    align-self: start;
    background: linear-gradient(135deg,
      color-mix(in oklch, var(--foot-accent) 18%, var(--sl-color-bg)) 0%,
      var(--sl-color-bg) 100%);
    font-weight: 600;
  }

  /* Bottom bar */
  .atlas-foot__bar {
    max-width: 80rem;
    margin: 2.5rem auto 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--foot-shade);
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.2rem;
    justify-content: space-between;
    align-items: center;
    font-size: 0.78rem;
  }
  .atlas-foot__bar p { margin: 0; }
  .atlas-foot__bar a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--foot-line);
    text-underline-offset: 2px;
  }
  .atlas-foot__bar a:hover {
    color: var(--sl-color-text-accent);
    text-decoration-color: currentColor;
  }
  .atlas-foot__bar kbd {
    display: inline-block;
    padding: 0.05em 0.4em;
    border: 1px solid var(--sl-color-hairline-shade);
    border-bottom-width: 2px;
    border-radius: 4px;
    background: var(--sl-color-gray-7);
    font-family: var(--atlas-font-mono);
    font-size: 0.85em;
  }
</style>
