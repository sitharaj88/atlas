  <p class="atlas-mute">
    © {new Date().getFullYear()} Sitharaj Seenivasan · Released under the MIT license. Content under CC BY-SA 4.0. ·
    Press <kbd>?</kbd> for keyboard shortcuts.
  </p>
</div>

<style>
  .atlas-footer-meta {
    margin-top: var(--atlas-sp-10);
    padding-top: var(--atlas-sp-6);
    border-top: 1px solid var(--sl-color-hairline-light);
    font-size: var(--atlas-fs-sm);
    color: var(--sl-color-gray-3);
    text-align: center;
  }
  .atlas-footer-meta p {
    margin: var(--atlas-sp-2) 0;
  }
  .atlas-footer-meta__author a {
    color: var(--sl-color-text);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px dotted var(--sl-color-hairline-shade);
  }
  .atlas-footer-meta__author a:hover {
    color: var(--sl-color-text-accent);
    border-bottom-color: currentColor;
  }
  .atlas-footer-meta__socials {
    list-style: none;
    margin: var(--atlas-sp-3) 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 0.6rem;
  }
  .atlas-footer-meta__socials a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--atlas-radius-pill, 999px);
    color: var(--sl-color-gray-2);
    text-decoration: none;
    font-size: 0.82rem;
    transition: border-color var(--atlas-dur-fast, 180ms), color var(--atlas-dur-fast, 180ms);
  }
  .atlas-footer-meta__socials a:hover {
    border-color: var(--atlas-amber-400, #F5B14A);
    color: var(--sl-color-text-accent);
  }
  .atlas-footer-meta__socials svg {
    display: inline-block;
  }
  .atlas-footer-meta kbd {
    display: inline-block;
    padding: 0.1em 0.4em;
    border: 1px solid var(--sl-color-hairline-shade);
    border-bottom-width: 2px;
    border-radius: 4px;
    background: var(--sl-color-gray-7);
    font-family: var(--atlas-font-mono);
    font-size: 0.85em;
  }
</style>
