---
import Compass from './Compass.astro';
import { withBase } from '../lib/url';

interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const {
  eyebrow = 'Atlas · v0.1',
  title,
  lede,
  primaryHref = '/start/',
  primaryLabel = 'Start your journey',
  secondaryHref = '/paths/',
  secondaryLabel = 'Browse all paths',
} = Astro.props;
---

<section class="atlas-hero">
  <div class="atlas-hero__copy">
    <span class="atlas-hero__eyebrow">
      <span class="atlas-hero__eyebrow-dot" aria-hidden="true"></span>
      {eyebrow}
    </span>
    <h1 class="atlas-hero__title" set:html={title} />
    {lede && <p class="atlas-hero__lede">{lede}</p>}
    <div class="atlas-hero__cta">
      <a class="atlas-btn" href={withBase(primaryHref)}>
        {primaryLabel}
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M3 8h9M8 3l5 5-5 5" fill="none" stroke="currentColor"
            stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <a class="atlas-btn atlas-btn--ghost" href={withBase(secondaryHref)}>
        {secondaryLabel}
      </a>
    </div>

    <ul class="atlas-hero__stats" aria-label="What's inside">
      <li>
        <span class="atlas-hero__stat-num">9</span>
        <span class="atlas-hero__stat-label">learning paths</span>
      </li>
      <li>
        <span class="atlas-hero__stat-num">230+</span>
        <span class="atlas-hero__stat-label">lessons</span>
      </li>
      <li>
        <span class="atlas-hero__stat-num">∞</span>
        <span class="atlas-hero__stat-label">free, forever</span>
      </li>
    </ul>
  </div>

  <div class="atlas-hero__art" aria-hidden="true">
    <div class="atlas-hero__art-glow"></div>
    <Compass spin class="atlas-hero__compass" />
  </div>
</section>

<style>
  .atlas-hero__eyebrow-dot {
    display: inline-block;
    width: 6px; height: 6px;
    border-radius: 999px;
    background: var(--atlas-amber-400);
    box-shadow: 0 0 0 4px oklch(72% 0.18 65 / 0.18);
    animation: atlas-eyebrow-pulse 2.4s ease-in-out infinite;
  }
  @keyframes atlas-eyebrow-pulse {
    0%, 100% { box-shadow: 0 0 0 3px oklch(72% 0.18 65 / 0.18); }
    50%      { box-shadow: 0 0 0 6px oklch(72% 0.18 65 / 0.04); }
  }

  .atlas-hero__copy { position: relative; z-index: 1; }

  .atlas-hero__stats {
    display: flex;
    gap: var(--atlas-sp-8);
    list-style: none;
    margin: var(--atlas-sp-12) 0 0;
    padding: 0;
    flex-wrap: wrap;
  }
  .atlas-hero__stats li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .atlas-hero__stat-num {
    font-family: var(--atlas-font-display);
    font-size: var(--atlas-fs-2xl);
    font-weight: 600;
    letter-spacing: var(--atlas-tracking-tight);
    line-height: 1;
    background: var(--grad-text-amber);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .atlas-hero__stat-label {
    font-size: var(--atlas-fs-xs);
    font-weight: 500;
    color: var(--sl-color-gray-3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .atlas-hero__art {
    position: relative;
    width: 100%;
    max-width: 30rem;
    justify-self: center;
    color: var(--atlas-amber-400);
  }
  .atlas-hero__art-glow {
    position: absolute;
    inset: 8%;
    z-index: -1;
    border-radius: 50%;
    background:
      radial-gradient(circle, oklch(72% 0.18 65 / 0.45) 0%, transparent 65%),
      conic-gradient(from 200deg, oklch(70% 0.18 65 / 0.4), oklch(60% 0.18 280 / 0.3), oklch(68% 0.16 200 / 0.3), oklch(70% 0.18 65 / 0.4));
    filter: blur(40px);
    animation: atlas-glow-rotate 16s linear infinite;
  }
  @keyframes atlas-glow-rotate {
    to { transform: rotate(360deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .atlas-hero__art-glow { animation: none; }
  }

  .atlas-hero__compass {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 20px 50px oklch(72% 0.18 65 / 0.35));
  }

  /* On narrow screens, hide the big compass — let the mesh handle visuals */
  @media (max-width: 60rem) {
    .atlas-hero__art { display: none; }
  }
</style>
