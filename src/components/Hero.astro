---
import HeroStack from './HeroStack.astro';
import { withBase } from '../lib/url';

interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const {
  eyebrow = 'Atlas · v0.1',
  title,
  lede,
  primaryHref = '/start/',
  primaryLabel = 'Start your journey',
  secondaryHref = '/paths/',
  secondaryLabel = 'Browse all paths',
} = Astro.props;

const TOPICS = [
  'HTML5', 'Modern CSS', 'TypeScript', 'React', 'Vue', 'Svelte',
  'Server Components', 'Hono', 'Postgres', 'Drizzle', 'Auth & passkeys',
  'Web Vitals', 'Accessibility', 'Playwright', 'GitHub Actions',
  'Edge runtimes', 'WebAssembly', 'WebGPU', 'CRDTs', 'AI · RAG · MCP',
];
---

<section class="atlas-hero">
  <div class="atlas-hero__grid" aria-hidden="true"></div>

  <div class="atlas-hero__copy">
    <span class="atlas-hero__eyebrow">
      <span class="atlas-hero__eyebrow-dot" aria-hidden="true"></span>
      {eyebrow}
    </span>
    <h1 class="atlas-hero__title" set:html={title} />
    {lede && <p class="atlas-hero__lede">{lede}</p>}

    <div class="atlas-hero__cta">
      <a class="atlas-btn" href={withBase(primaryHref)}>
        {primaryLabel}
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M3 8h9M8 3l5 5-5 5" fill="none" stroke="currentColor"
            stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <a class="atlas-btn atlas-btn--ghost" href={withBase(secondaryHref)}>
        {secondaryLabel}
      </a>
    </div>

    <ul class="atlas-hero__stats" aria-label="What's inside">
      <li>
        <span class="atlas-hero__stat-num">9</span>
        <span class="atlas-hero__stat-label">learning paths</span>
      </li>
      <li>
        <span class="atlas-hero__stat-num">230+</span>
        <span class="atlas-hero__stat-label">lessons</span>
      </li>
      <li>
        <span class="atlas-hero__stat-num">∞</span>
        <span class="atlas-hero__stat-label">free, forever</span>
      </li>
    </ul>

    {/* Topic marquee — scrolling pills demonstrating breadth */}
    <div class="atlas-hero__topics" aria-label="Topics you'll learn">
      <div class="atlas-hero__topics-fade atlas-hero__topics-fade--left" aria-hidden="true"></div>
      <div class="atlas-hero__topics-track">
        {[...TOPICS, ...TOPICS].map((t) => (
          <span class="atlas-hero__topic">{t}</span>
        ))}
      </div>
      <div class="atlas-hero__topics-fade atlas-hero__topics-fade--right" aria-hidden="true"></div>
    </div>
  </div>

  <div class="atlas-hero__art" aria-hidden="true">
    <HeroStack />
  </div>

  {/* Scroll cue at the bottom */}
  <a class="atlas-hero__scroll" href="#below" aria-label="Scroll to content">
    <span class="atlas-hero__scroll-track">
      <span class="atlas-hero__scroll-dot"></span>
    </span>
    <span class="atlas-hero__scroll-text">Scroll</span>
  </a>
</section>

<span id="below"></span>

<style>
  /* Dotted grid pattern overlay — subtle structure beneath the mesh */
  .atlas-hero__grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      radial-gradient(oklch(100% 0 0 / 0.06) 1px, transparent 1px);
    background-size: 28px 28px;
    background-position: -1px -1px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, black 0%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, black 0%, transparent 80%);
    pointer-events: none;
  }
  :root[data-theme='light'] .atlas-hero__grid {
    background-image:
      radial-gradient(oklch(20% 0.04 250 / 0.08) 1px, transparent 1px);
  }

  /* Eyebrow with pulsing dot */
  .atlas-hero__eyebrow-dot {
    display: inline-block;
    width: 6px; height: 6px;
    border-radius: 999px;
    background: var(--atlas-amber-400);
    box-shadow: 0 0 0 4px oklch(72% 0.18 65 / 0.18);
    animation: atlas-eyebrow-pulse 2.4s ease-in-out infinite;
  }
  @keyframes atlas-eyebrow-pulse {
    0%, 100% { box-shadow: 0 0 0 3px oklch(72% 0.18 65 / 0.18); }
    50%      { box-shadow: 0 0 0 6px oklch(72% 0.18 65 / 0.04); }
  }

  .atlas-hero__copy {
    position: relative;
    z-index: 1;
    /* Subtle reveal-on-load */
    animation: atlas-hero-rise 700ms var(--atlas-ease-out) both;
  }
  @keyframes atlas-hero-rise {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .atlas-hero__copy { animation: none; }
  }

  /* Stats row */
  .atlas-hero__stats {
    display: flex;
    gap: var(--atlas-sp-8);
    list-style: none;
    margin: var(--atlas-sp-10) 0 0;
    padding: var(--atlas-sp-6) 0 0;
    flex-wrap: wrap;
    border-top: 1px solid var(--sl-color-hairline-light);
  }
  .atlas-hero__stats li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .atlas-hero__stat-num {
    font-family: var(--atlas-font-display);
    font-size: var(--atlas-fs-2xl);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1;
    background: var(--grad-text-amber);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .atlas-hero__stat-label {
    font-size: var(--atlas-fs-xs);
    font-weight: 500;
    color: var(--sl-color-gray-3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* Topic marquee */
  .atlas-hero__topics {
    position: relative;
    margin-top: var(--atlas-sp-8);
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent 0, black 8%, black 92%, transparent 100%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0, black 8%, black 92%, transparent 100%);
  }
  .atlas-hero__topics-track {
    display: flex;
    gap: 0.5rem;
    width: max-content;
    animation: atlas-topics-scroll 36s linear infinite;
  }
  @keyframes atlas-topics-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .atlas-hero__topics-track { animation: none; }
  }
  .atlas-hero__topics-fade { display: none; }

  .atlas-hero__topic {
    display: inline-flex;
    align-items: center;
    padding: 0.4em 0.85em;
    font-size: 0.78rem;
    font-weight: 500;
    border-radius: var(--atlas-radius-pill);
    background: oklch(15% 0.03 250 / 0.6);
    border: 1px solid oklch(100% 0 0 / 0.07);
    color: var(--sl-color-gray-2);
    white-space: nowrap;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    transition: border-color var(--atlas-dur-fast) var(--atlas-ease);
  }
  :root[data-theme='light'] .atlas-hero__topic {
    background: oklch(100% 0 0 / 0.7);
    border-color: oklch(20% 0.04 250 / 0.08);
  }
  .atlas-hero__topic:hover {
    border-color: oklch(72% 0.18 65 / 0.4);
  }

  /* Right-side art (HeroStack) */
  .atlas-hero__art {
    position: relative;
    width: 100%;
    z-index: 0;
    animation: atlas-hero-rise 900ms var(--atlas-ease-out) 100ms both;
  }

  /* Scroll cue */
  .atlas-hero__scroll {
    position: absolute;
    bottom: var(--atlas-sp-4);
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.7rem;
    border-radius: var(--atlas-radius-pill);
    color: var(--sl-color-gray-3);
    text-decoration: none;
    font-size: 0.72rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    opacity: 0.65;
    transition: opacity var(--atlas-dur-fast) var(--atlas-ease);
  }
  .atlas-hero__scroll:hover { opacity: 1; }
  .atlas-hero__scroll-track {
    width: 16px;
    height: 22px;
    border: 1.5px solid currentColor;
    border-radius: 999px;
    position: relative;
    flex-shrink: 0;
  }
  .atlas-hero__scroll-dot {
    position: absolute;
    top: 4px;
    left: 50%;
    transform: translateX(-50%);
    width: 3px;
    height: 5px;
    background: currentColor;
    border-radius: 999px;
    animation: atlas-scroll-bounce 1.8s ease-in-out infinite;
  }
  @keyframes atlas-scroll-bounce {
    0%, 100% { transform: translate(-50%, 0); opacity: 1; }
    50%      { transform: translate(-50%, 6px); opacity: 0.4; }
  }
  @media (prefers-reduced-motion: reduce) {
    .atlas-hero__scroll-dot { animation: none; }
  }
  @media (max-width: 50em) {
    .atlas-hero__scroll { display: none; }
  }

  /* Hide stack on narrow screens */
  @media (max-width: 60em) {
    .atlas-hero__art { display: none; }
  }
</style>
