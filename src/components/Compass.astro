---
interface Props {
  size?: number | string;
  class?: string;
  spin?: boolean;
}
const { size = '100%', class: className = '', spin = false } = Astro.props;
---

<svg
  class:list={[className, spin && 'atlas-compass-spin']}
  viewBox="0 0 240 240"
  width={size}
  height={size}
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <radialGradient id="atlas-glow" cx="50%" cy="50%" r="50%">
      <stop offset="0" stop-color="rgba(245,177,74,0.35)" />
      <stop offset="0.6" stop-color="rgba(245,177,74,0.05)" />
      <stop offset="1" stop-color="rgba(245,177,74,0)" />
    </radialGradient>
    <linearGradient id="atlas-needle-grad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#F5B14A" />
      <stop offset="0.5" stop-color="#F5B14A" />
      <stop offset="0.5" stop-color="#1c3963" />
      <stop offset="1" stop-color="#0B1B2B" />
    </linearGradient>
  </defs>

  <circle cx="120" cy="120" r="115" fill="url(#atlas-glow)" />

  <g fill="none" stroke="currentColor" opacity="0.55">
    <circle cx="120" cy="120" r="100" stroke-width="1.5" />
    <circle cx="120" cy="120" r="78" stroke-width="0.8" stroke-dasharray="3 4" />
    <circle cx="120" cy="120" r="56" stroke-width="0.6" stroke-dasharray="2 5" />
  </g>

  <g stroke="currentColor" stroke-linecap="round" opacity="0.7">
    <line x1="120" y1="6" x2="120" y2="22" stroke-width="2" />
    <line x1="120" y1="218" x2="120" y2="234" stroke-width="2" />
    <line x1="6" y1="120" x2="22" y2="120" stroke-width="2" />
    <line x1="218" y1="120" x2="234" y2="120" stroke-width="2" />
  </g>

  <g class="atlas-tick-group" stroke="currentColor" opacity="0.5">
    {Array.from({ length: 36 }).map((_, i) => {
      const a = (i * 10 * Math.PI) / 180;
      const inner = 92;
      const outer = i % 9 === 0 ? 102 : 99;
      const x1 = 120 + Math.sin(a) * inner;
      const y1 = 120 - Math.cos(a) * inner;
      const x2 = 120 + Math.sin(a) * outer;
      const y2 = 120 - Math.cos(a) * outer;
      return <line x1={x1} y1={y1} x2={x2} y2={y2} stroke-width={i % 9 === 0 ? 1.5 : 0.8} />;
    })}
  </g>

  <text
    x="120" y="14" text-anchor="middle" font-size="10" font-family="ui-monospace, monospace"
    fill="currentColor" opacity="0.7">N</text>
  <text
    x="120" y="232" text-anchor="middle" font-size="10" font-family="ui-monospace, monospace"
    fill="currentColor" opacity="0.7">S</text>
  <text
    x="14" y="124" text-anchor="middle" font-size="10" font-family="ui-monospace, monospace"
    fill="currentColor" opacity="0.7">W</text>
  <text
    x="226" y="124" text-anchor="middle" font-size="10" font-family="ui-monospace, monospace"
    fill="currentColor" opacity="0.7">E</text>

  <g class="atlas-needle" transform="translate(120 120) rotate(35)">
    <polygon
      points="0,-78 14,0 0,78 -14,0"
      fill="url(#atlas-needle-grad)"
      stroke="#0B1B2B"
      stroke-width="1"
      stroke-linejoin="round"
    />
    <circle r="8" fill="#0B1B2B" />
    <circle r="3" fill="#F5B14A" />
  </g>
</svg>

<style>
  .atlas-compass-spin .atlas-needle {
    transform-origin: 120px 120px;
    animation: atlas-needle-sweep 14s var(--atlas-ease, cubic-bezier(0.2, 0.65, 0.2, 1)) infinite;
  }

  @keyframes atlas-needle-sweep {
    0%   { transform: translate(120px, 120px) rotate(0deg); }
    25%  { transform: translate(120px, 120px) rotate(72deg); }
    50%  { transform: translate(120px, 120px) rotate(-30deg); }
    75%  { transform: translate(120px, 120px) rotate(110deg); }
    100% { transform: translate(120px, 120px) rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .atlas-compass-spin .atlas-needle {
      animation: none;
    }
  }
</style>
