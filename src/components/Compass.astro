---
interface Props {
  size?: number | string;
  class?: string;
  spin?: boolean;
}
const { size = '100%', class: className = '', spin = false } = Astro.props;
---

<svg
  class:list={[className, spin && 'atlas-compass-spin']}
  viewBox="0 0 240 240"
  width={size}
  height={size}
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <radialGradient id="atlas-glow" cx="50%" cy="50%" r="50%">
      <stop offset="0" stop-color="oklch(72% 0.18 65 / 0.45)" />
      <stop offset="0.55" stop-color="oklch(72% 0.18 65 / 0.08)" />
      <stop offset="1" stop-color="oklch(72% 0.18 65 / 0)" />
    </radialGradient>
    <linearGradient id="atlas-needle-grad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="oklch(80% 0.18 75)" />
      <stop offset="0.5" stop-color="oklch(72% 0.18 60)" />
      <stop offset="0.5" stop-color="oklch(20% 0.06 250)" />
      <stop offset="1" stop-color="oklch(10% 0.04 250)" />
    </linearGradient>
    <linearGradient id="atlas-ring" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="oklch(72% 0.18 65 / 0.7)" />
      <stop offset="0.5" stop-color="oklch(72% 0.18 65 / 0.15)" />
      <stop offset="1" stop-color="oklch(72% 0.18 65 / 0.7)" />
    </linearGradient>
  </defs>

  <!-- glow -->
  <circle cx="120" cy="120" r="118" fill="url(#atlas-glow)" />

  <!-- outer ring with gradient stroke -->
  <circle cx="120" cy="120" r="100" fill="none" stroke="url(#atlas-ring)" stroke-width="1.5" />
  <!-- mid dashed ring -->
  <circle cx="120" cy="120" r="78" fill="none" stroke="currentColor" stroke-width="0.7"
    stroke-dasharray="2 5" opacity="0.4" />
  <!-- inner subtle ring -->
  <circle cx="120" cy="120" r="56" fill="none" stroke="currentColor" stroke-width="0.5"
    stroke-dasharray="1 4" opacity="0.3" />

  <!-- cardinal pointer ticks -->
  <g stroke="currentColor" stroke-linecap="round" opacity="0.85">
    <line x1="120" y1="6"   x2="120" y2="22"  stroke-width="2.2" />
    <line x1="120" y1="218" x2="120" y2="234" stroke-width="2.2" />
    <line x1="6"   y1="120" x2="22"  y2="120" stroke-width="2.2" />
    <line x1="218" y1="120" x2="234" y2="120" stroke-width="2.2" />
  </g>

  <!-- minor ticks -->
  <g class="atlas-tick-group" stroke="currentColor" opacity="0.5">
    {Array.from({ length: 36 }).map((_, i) => {
      const a = (i * 10 * Math.PI) / 180;
      const inner = 92;
      const outer = i % 9 === 0 ? 102 : 99;
      const x1 = 120 + Math.sin(a) * inner;
      const y1 = 120 - Math.cos(a) * inner;
      const x2 = 120 + Math.sin(a) * outer;
      const y2 = 120 - Math.cos(a) * outer;
      return <line x1={x1} y1={y1} x2={x2} y2={y2} stroke-width={i % 9 === 0 ? 1.5 : 0.8} />;
    })}
  </g>

  <!-- N S E W -->
  <g font-family="var(--atlas-font-mono)" font-size="11" font-weight="700"
     fill="currentColor" opacity="0.85">
    <text x="120" y="14"  text-anchor="middle">N</text>
    <text x="120" y="232" text-anchor="middle">S</text>
    <text x="14"  y="124" text-anchor="middle">W</text>
    <text x="226" y="124" text-anchor="middle">E</text>
  </g>

  <!-- needle -->
  <g class="atlas-needle" transform="translate(120 120) rotate(35)">
    <polygon
      points="0,-78 12,0 0,78 -12,0"
      fill="url(#atlas-needle-grad)"
      stroke="oklch(10% 0.04 250)"
      stroke-width="0.8"
      stroke-linejoin="round"
    />
    <circle r="9" fill="oklch(10% 0.04 250)" />
    <circle r="3" fill="oklch(80% 0.18 75)" />
  </g>
</svg>

<style>
  .atlas-compass-spin .atlas-needle {
    transform-origin: 120px 120px;
    animation: atlas-needle-sweep 14s var(--atlas-ease-out) infinite;
  }

  @keyframes atlas-needle-sweep {
    0%   { transform: translate(120px, 120px) rotate(0deg); }
    25%  { transform: translate(120px, 120px) rotate(72deg); }
    50%  { transform: translate(120px, 120px) rotate(-30deg); }
    75%  { transform: translate(120px, 120px) rotate(110deg); }
    100% { transform: translate(120px, 120px) rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .atlas-compass-spin .atlas-needle { animation: none; }
  }
</style>
